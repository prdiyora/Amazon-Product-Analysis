{
  "manifest_version": 3,
  "name": "Amazon Product Analysis",
  "version": "1.3.3",
  "description": "Analyze up to 50 products from the current Amazon.in or Amazon.com listing page and save sorted results to Google Sheets.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://amazon.in/*",
    "https://www.amazon.com/*",
    "https://amazon.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Amazon Product Analysis",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://amazon.in/*",
        "https://www.amazon.com/*",
        "https://amazon.com/*"
      ],
      "js": [
        "src/shared/messages.js",
        "src/shared/errors.js",
        "src/shared/utils.js",
        "src/parsers/listing-parser.js",
        "src/parsers/product-parser.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
